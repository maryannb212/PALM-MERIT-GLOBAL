# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=palmmerit
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# Payment Gateways
PAYMENT_MODE=live   # Options: live | test | mock
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_xxxx

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx

# SMTP / Email (For Notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=xxxx
SMTP_PASS=xxxx
EMAIL_FROM=info@palmmeritglobal.com
EMAIL_FROM_NAME="Palm Merit Global"
CLIENT_URL=http://localhost:3000
