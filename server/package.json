{
  "name": "palm-merit-global-server",
  "version": "1.0.0",
  "description": "Backend API for Palm Merit Global Platform",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm install && npx knex migrate:latest",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "cron:deduction": "node -e \"import('./src/jobs/deductionJob.js').then(m => m.runDeductionJob()).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "cron:penalty": "node -e \"import('./src/jobs/penaltyJob.js').then(m => m.runPenaltyCheck()).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.15.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.4",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.3",
    "pg-query-stream": "^4.14.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
