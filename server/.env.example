# ═══════════════════════════════════════════════════════════════════════════════
# Palm Merit Global — Backend Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ──── SERVER ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ──── DATABASE (Neon PostgreSQL) ──────────────────────────────────────────────
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# ──── AUTHENTICATION ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──── PAYMENT GATEWAYS ───────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_MODE=production

# ──── EMAIL (SendGrid for production, SMTP for development) ──────────────────
SENDGRID_API_KEY=
EMAIL_FROM=info@palmmeritglobal.com
EMAIL_FROM_NAME=Palm Merit Global

# SMTP fallback (development only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ──── SMS (Termii) ───────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_SENDER_ID=N-Alert

# ──── CLOUD STORAGE (Cloudinary) ─────────────────────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ──── FRONTEND URL ───────────────────────────────────────────────────────────
# Used for CORS, email links, and payment redirects
# Supports comma-separated origins: https://palmmeritglobal.com,https://www.palmmeritglobal.com
CLIENT_URL=https://palmmeritglobal.com

# ──── ADMIN ──────────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
