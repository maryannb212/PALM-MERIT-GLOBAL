# DATABASE
# Neon PostgreSQL URL: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# AUTH
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PAYMENT GATEWAYS
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYMENT_MODE=production # or mock

# SMS & EMAIL
TERMII_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=info@palmmeritglobal.com
EMAIL_FROM_NAME=Palm Merit Global

# CLOUD STORAGE
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FRONTEND
CLIENT_URL=https://palmmeritglobal.com

# SERVER
PORT=5000
NODE_ENV=production
