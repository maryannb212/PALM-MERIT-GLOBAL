# ═══════════════════════════════════════════════════════════════════════════════
# Palm Merit Global — Backend Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ──── SERVER ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# DEPLOYMENT MODE
# Set to 'serverless' for Vercel, remove or set to 'vps' for Railway/VPS
DEPLOY_MODE=serverless

# ──── DATABASE (Neon PostgreSQL) ──────────────────────────────────────────────
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_tPSeF7XfORZ6@ep-cold-art-aqnjbgtw-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ──── AUTHENTICATION ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──── PAYMENT GATEWAYS ───────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_MODE=production

# ──── EMAIL (SendGrid for production, SMTP for development) ──────────────────
SENDGRID_API_KEY=
EMAIL_FROM=info@palmmeritglobal.com
EMAIL_FROM_NAME=Palm Merit Global

# SMTP fallback (development only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ──── SMS (Termii) ───────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_SENDER_ID=N-Alert

# ──── CLOUD STORAGE (Cloudinary) ─────────────────────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used for CORS, email links, and payment redirects
# Supports comma-separated origins: https://palmmeritglobal.com,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ──── ADMIN ──────────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
